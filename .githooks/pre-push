#!/bin/sh
# Reject an upload if the current JavaScript has a syntax error.
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
if ! git diff --quiet HEAD -- site; then
  printf '%s\n' '[LAGUNA] Commit the remaining site changes before push so checks cover the committed version.' >&2
  exit 1
fi
node site/scripts/check-private.mjs
printf '%s\n' '[LAGUNA] Checking JavaScript before push...'
npm --prefix site run check
