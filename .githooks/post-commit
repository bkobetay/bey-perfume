#!/bin/sh
# Send each completed commit to its configured upstream, preserving local history.
set -u

if [ "${BEY_SKIP_AUTO_PUSH:-0}" = "1" ]; then
  printf '%s\n' '[voxparfum.kz] Auto-push skipped explicitly; the commit is saved locally.' >&2
  exit 0
fi

branch=$(git symbolic-ref --quiet --short HEAD) || {
  printf '%s\n' '[voxparfum.kz] Detached HEAD: commit saved locally; no branch was pushed.' >&2
  exit 0
}
remote=$(git config --get "branch.$branch.remote") || remote=
merge_ref=$(git config --get "branch.$branch.merge") || merge_ref=
if [ -z "$remote" ] || [ -z "$merge_ref" ]; then
  printf '%s\n' '[voxparfum.kz] No upstream configured. Set it with git push -u before using auto-push.' >&2
  exit 0
fi

printf '%s\n' "[voxparfum.kz] Pushing $branch to $remote/$merge_ref..." >&2
if ! GIT_TERMINAL_PROMPT=0 git push --follow-tags "$remote" "HEAD:$merge_ref"; then
  printf '%s\n' '[voxparfum.kz] PUSH FAILED. The commit is safe locally but is NOT saved on GitHub.' \
    '[voxparfum.kz] Fix authentication, connection or divergence, then run git push --follow-tags.' >&2
fi
# A push failure must not suggest that the successful local commit was lost.
exit 0
